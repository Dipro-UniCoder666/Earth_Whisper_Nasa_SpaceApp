# --- Frontend (app/) ---
app/node_modules/
app/dist/
app/.vite/
app/*.local

# --- Backend (backend/) ---
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/

# GherProof fisheries records are runtime SQLite data, not source fixtures.
data/gherproof/fisheries/*.sqlite3
data/gherproof/fisheries/*.sqlite3-shm
data/gherproof/fisheries/*.sqlite3-wal

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Environment ---
.env
.env.local
.env.cdse.local

# --- Logs ---
*.log
npm-debug.log*

# Note: AquaByte_NISAR/ raster and geopackage files are intentionally
# tracked, not ignored — they are the team's scientific source data.

# Temporary and generated files
tmp/
**/__pycache__/
*.py[cod]
